# Copy to .env (never commit .env). Read by backend/config/settings.py.

DJANGO_DEBUG=True
# Required when DJANGO_DEBUG=False. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Origins allowed to call the API directly (used when the frontend bypasses the Vite proxy).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where screenplays and outputs live. Defaults to <repo>/data when empty.
RANGDRISHTI_DATA_DIR=

# --- AI judge (Stage 3) ---
# mock = offline placeholder scores (tests, demos without a key). gemini = Google Gemini via its OpenAI-compatible API.
LLM_PROVIDER=mock
# Pick a free-tier Flash model your key can use: python -m engine.judge --provider gemini --list-models
LLM_MODEL=
# Your key from Google AI Studio. Never commit .env.
LLM_API_KEY=
# Seconds between calls (6.5 s is about 9 requests/minute, inside free-tier limits).
LLM_MIN_INTERVAL_S=6.5
# Only for LLM_PROVIDER=openai_compatible (Groq, OpenRouter, Ollama...); the gemini preset fills it in.
# LLM_BASE_URL=
# Optional, model-dependent (e.g. low). Leave empty if unsure.
# LLM_REASONING_EFFORT=
