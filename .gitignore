# --- Secrets ---
.env
.env.*
!.env.example

# --- Confidential Kuku input pack and anything derived from it ---
# Everything under data/ stays local; only the empty folder markers are tracked.
data/**
!data/*/
!data/**/.gitkeep
# Belt and braces: never track screenplay files or the pack archive anywhere.
episode-*.txt
*.zip
**/raw_outputs/*
!data/raw_outputs/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
*.sqlite3

# --- Node / Vite ---
node_modules/
dist/
coverage/
*.local

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
