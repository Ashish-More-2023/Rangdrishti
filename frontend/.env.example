# Copy to frontend/.env.local if you need to change these (never commit it).

# Default (empty): the browser calls /api on the Vite dev server, which proxies to Django.
# Set to http://127.0.0.1:8000 to call Django directly instead (uses CORS).
VITE_API_BASE_URL=

# Where the Vite proxy forwards /api. 127.0.0.1, not localhost: on Windows, Node may
# resolve localhost to IPv6 (::1) while Django's runserver listens on IPv4 only.
VITE_PROXY_TARGET=http://127.0.0.1:8000
